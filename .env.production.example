APP_NAME=Lum
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# --- Mode A: IP preview (current) ---
# Leave DOMAIN empty.
APP_SCHEME=http
APP_HOST=45.151.62.114
APP_PORT=8080
APP_URL=http://45.151.62.114:8080
WEB_PORT=8080
WEB_BIND=0.0.0.0

# --- Mode B: real domain (Caddy + HTTPS) ---
# Set DOMAIN and run: ./scripts/go-live-domain.sh
# DOMAIN=lumresidence.com
# ACME_EMAIL=info@lumresidence.com
# APP_SCHEME=https
# APP_HOST=lumresidence.com
# APP_PORT=
# APP_URL=https://lumresidence.com
# WEB_BIND=127.0.0.1
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=.lumresidence.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Gmail SMTP (app password — NOT the normal Google password)
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=dimacake@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=dimacake@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Filament: extra allowlist (comma-separated). DB flag is_admin also required unless listed here.
ADMIN_EMAILS=dimacake@gmail.com
